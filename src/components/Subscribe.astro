---
import { SITE } from "../lib/site";

interface Props {
  /** Show the RSS / LinkedIn links before the form. Off on pages that already list them. */
  links?: boolean;
}
const { links = true } = Astro.props;
---

<div class="frame">
  <span class="frame-title">subscribe</span>
  <div class="subscribe-row">
    {links && <a href="/rss.xml">RSS</a>}
    {links && <a href={SITE.linkedin}>LinkedIn</a>}
    <form action={SITE.newsletterAction} method="post" target="_blank">
      <label for="nl-email">a deep dive every month or two:</label>
      <input
        id="nl-email"
        type="email"
        name="email"
        required
        placeholder="you@example.com"
      />
      <button type="submit">follow</button>
    </form>
  </div>
</div>
