---
import { SITE } from "../lib/site"

interface Props {
  /** Off on pages that already list the social links. */
  links?: boolean
}
const { links = true } = Astro.props
---

<section class="subscribe" aria-labelledby="subscribe-heading">
  <div class="subscribe-intro">
    <h2 id="subscribe-heading" class="frame-title">subscribe</h2>
    {
      links && (
        <div class="subscribe-links">
          <a href="/rss.xml">RSS</a>
          <a href={SITE.linkedin}>LinkedIn</a>
        </div>
      )
    }
  </div>
  <form class="subscribe-form" action={SITE.newsletterAction} method="post" target="_blank">
    <label for="nl-email">a deep dive every month or two:</label>
    <div class="subscribe-fields">
      <input
        id="nl-email"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
      <button type="submit">follow</button>
    </div>
  </form>
</section>
