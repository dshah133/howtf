---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

// gdb-backtrace TOC: h2s are numbered frames (#0, #1, …), h3s indent under them
const { headings } = Astro.props;
const items: {
  slug: string;
  text: string;
  frame: string | null;
  sub: boolean;
}[] = [];
let frame = 0;
for (const h of headings) {
  if (h.depth === 2) {
    // the frame number (#0, #1, …) already counts h2s; drop a leading
    // "1. " from the heading text so the rail doesn't number twice
    const text = h.text.replace(/^\d+[.)]\s+/, "");
    items.push({ slug: h.slug, text, frame: `#${frame++}`, sub: false });
  } else if (h.depth === 3) {
    items.push({ slug: h.slug, text: h.text, frame: null, sub: true });
  }
}
---

{
  items.length > 0 && (
    <nav class="rail" aria-label="table of contents" data-toc>
      <details class="rail-toc" open>
        <summary class="rail-title">backtrace</summary>
        <ol>
          {items.map((i) => (
            <li class={i.sub ? "sub" : undefined}>
              <a href={`#${i.slug}`}>
                {i.frame && <span class="fno">{i.frame}</span>}
                <span>{i.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}
