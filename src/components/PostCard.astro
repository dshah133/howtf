---
import type { CollectionEntry } from "astro:content"
import { fmtDate, readingTime } from "../lib/site"
interface Props {
  post: CollectionEntry<"blog">
  label?: string
  tag?: string
  lead?: boolean
}
const { post, label = "post", tag, lead = false } = Astro.props
const { title, description, date, series } = post.data
---

<a class:list={["post-entry", { lead }]} href={`/blog/${post.id}/`}>
  <div class="entry-date">
    <span class="entry-label">{label}</span>
    <time datetime={date.toISOString()}>{fmtDate(date)}</time>
  </div>
  <div class="entry-content">
    {tag && <span class="entry-tag">{tag}</span>}
    <h2>{title}<span class="entry-arrow" aria-hidden="true">→</span></h2>
    <p class="entry-dek">{description}</p>
    <p class="entry-meta">
      {
        series && (
          <span>
            {series.name} · Part {series.part}
          </span>
        )
      }
      <span>{readingTime(post.body ?? "")}</span>
    </p>
  </div>
</a>
