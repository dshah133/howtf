---
import { TOPIC_HUBS } from "../lib/site"
interface Props {
  current?: string
  count: number
}
const { current, count } = Astro.props
---

<div class="topic-navigation">
  <nav class="topic-tabs" aria-label="Browse posts by topic">
    <a href="/blog/" aria-current={!current ? "page" : undefined}>All topics</a>
    {
      Object.entries(TOPIC_HUBS).map(([tag, hub]) => (
        <a href={hub.href} aria-current={current === tag ? "page" : undefined}>
          {tag === "rdma" ? "RDMA" : tag}
        </a>
      ))
    }
  </nav>
  <span class="archive-count">{count} {count === 1 ? "article" : "articles"}</span>
</div>
