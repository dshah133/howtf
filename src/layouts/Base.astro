---
import SiteMark from "../components/SiteMark.astro"
import "../styles/global.css"
import { SITE } from "../lib/site"

interface Props {
  title: string
  description: string
  canonical?: string
  ogType?: "website" | "article"
  ogImage?: string
  jsonLd?: object[]
  header?: boolean
  current?: string
}
const {
  title,
  description,
  ogType = "website",
  ogImage = "/og/default.png",
  jsonLd = [],
  header = true,
  current,
} = Astro.props
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, Astro.site).href
const ogImageUrl = new URL(ogImage, Astro.site).href
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link
      rel="preload"
      href="/fonts/iAWriterQuattroS-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      ;(() => {
        let theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
        try {
          const saved = localStorage.getItem("howtf-theme")
          if (saved === "dark" || saved === "light") theme = saved
        } catch {}
        document.documentElement.dataset.theme = theme
      })()
    </script>
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <script defer data-domain="howtf.io" src="https://plausible.io/js/script.outbound-links.js"
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      header && (
        <header class="site-header">
          <a class="wordmark" href="/" aria-label="howtf.io home">
            <SiteMark />howtf.io
          </a>
          <nav aria-label="Main navigation">
            {["blog", "series", "tools", "about"].map((route) => (
              <a href={`/${route}/`} aria-current={current === route ? "page" : undefined}>
                {route === "blog" ? "posts" : route}
              </a>
            ))}
            <a href="/rss.xml">rss</a>
          </nav>
          <button type="button" class="theme-toggle" aria-label="Switch to dark theme">
            <>
              <span class="theme-disc" aria-hidden="true" />
              <span data-theme-name>Light</span>
            </>
          </button>
        </header>
      )
    }
    <slot />
    <footer class="site-footer">
      <div><a class="footer-name" href="/"><SiteMark />howtf.io</a><span>{SITE.author}</span></div>
      <nav aria-label="Footer navigation">
        <a href="/blog/">All posts</a><a href="/topics/rdma/">RDMA</a>
        <a href={SITE.linkedin}>LinkedIn ↗</a><a href="/rss.xml">RSS ↗</a>
      </nav>
      <p>Deep dives from the bottom of the systems stack.</p>
    </footer>
    <script>
      const toggles = [...document.querySelectorAll<HTMLButtonElement>(".theme-toggle")]
      const sync = () => {
        const dark = document.documentElement.dataset.theme === "dark"
        document
          .querySelectorAll("[data-theme-name]")
          .forEach((el) => (el.textContent = dark ? "Dark" : "Light"))
        toggles.forEach((toggle) =>
          toggle.setAttribute("aria-label", `Switch to ${dark ? "light" : "dark"} theme`),
        )
      }
      toggles.forEach((toggle) =>
        toggle.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark"
          document.documentElement.dataset.theme = next
          try {
            localStorage.setItem("howtf-theme", next)
          } catch {}
          sync()
        }),
      )
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
        try {
          const saved = localStorage.getItem("howtf-theme")
          if (saved === "dark" || saved === "light") return
        } catch {}
        document.documentElement.dataset.theme = event.matches ? "dark" : "light"
        sync()
      })
      sync()
    </script>
  </body>
</html>
