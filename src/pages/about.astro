---
import Base from "../layouts/Base.astro";
import Subscribe from "../components/Subscribe.astro";
import { SITE } from "../lib/site";
---

<Base
  title={`about · ${SITE.title}`}
  description="Deep Shah, systems engineer. Meta Llama pre-training infrastructure, VMware virtual machine monitor, Linux kernel PTP."
  canonical="/about/"
  current="about"
>
  <main class="shell">
    <div class="home-center">
      <div class="frame bio">
        <span class="frame-title">whoami --long</span>
        <div>
          <p>
            I'm Deep Shah. I build systems for agentic workflows at a stealth startup
            in the Bay Area. Previously at Meta, I worked on large-scale Llama training
            infrastructure, collective communications, and the GB200 training stack.
            Before that I was on VMware's Virtual Machine Monitor team, deep in the
            virtualization stack.
          </p>
          <p class="links">
            <a href={SITE.linkedin}>LinkedIn</a> ·
            <a href="/rss.xml">RSS</a>
          </p>
        </div>
      </div>
      <Subscribe />
    </div>
  </main>
</Base>
